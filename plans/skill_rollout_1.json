    "variants": [
      { "key": "control", "value": "control" },
      { "key": "variant_b", "value": "variant_b" }
    ]
  },
  "metric": { "name": "Get started clicks (skill_rollout_1)", "event": "cta_clicked", "direction": "up" },
  "split": { "control": 50, "variant_b": 50 },
  "identity": {
    "source": "visitor id generated on first visit and kept in localStorage",
    "usedFor": ["flag", "events"],
    "prefixReal": "web_",
    "prefixScripted": "sim_"
  },
  "stopRule": { "type": "minExposuresPerVariant", "value": 50 },
  "decisionRule": { "primaryMetric": "Get started clicks (skill_rollout_1)", "winProbabilityAtLeast": 0.95, "intervalExcludesZero": true },
  "traffic": { "real": false, "scripted": true }
