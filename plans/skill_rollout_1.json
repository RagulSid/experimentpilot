  "hypothesis": "Showing \"Yesterday's 5 biggest creator posts, in 60 seconds. See today's.\" instead of \"Your creator digest, summarized by AI\" increases Get started clicks.",
  "environment": "Development",
  "flag": {
    "key": "skill_rollout_1",
